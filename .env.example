# Copy to .env (or run: node scripts/setup-env.js to generate one with random secrets)
PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ogv_app
DB_PASSWORD=change-me
DB_NAME=ogv_finder
# Set to true for hosted MySQL that requires SSL
DB_SSL=false

# Shared password for the IR team
IR_PASSWORD=change-me
# Long random string used to sign login cookies
COOKIE_SECRET=change-me-to-a-long-random-string
