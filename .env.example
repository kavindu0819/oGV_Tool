# Copy to .env (or run: node scripts/setup-env.js to generate one with random secrets)
PORT=3000

# Postgres connection string.
# Neon / Vercel: paste the pooled connection string from the Neon dashboard.
# Local Docker (npm run db:up): postgres://ogv_app:<DB_PASSWORD>@127.0.0.1:5432/ogv_finder
DB_PASSWORD=change-me
DATABASE_URL=postgres://ogv_app:change-me@127.0.0.1:5432/ogv_finder

# Shared password for the IR team
IR_PASSWORD=change-me
# Long random string used to sign login cookies
COOKIE_SECRET=change-me-to-a-long-random-string
